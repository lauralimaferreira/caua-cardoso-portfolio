# Set these in Railway Variables, never commit real values.
DATABASE_URL=
APP_ORIGIN=
ADMIN_USERNAME=caua
ADMIN_PASSWORD_HASH=
# Defaults to production; only use development on localhost.
NODE_ENV=production
# Railway HTTP edge only; direct for localhost development.
AUTH_CLIENT_IP_MODE=railway-edge
# Exact origin of the public frontend; only public GET requests get CORS access.
PUBLIC_SITE_ORIGIN=https://caua-cardoso-portfolio.vercel.app
